---
import Base from "../../layouts/Base.astro";
import { profile, projects, type Project } from "../../data/content";

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { p, prev, next } = Astro.props as { p: Project; prev?: Project; next?: Project };
---

<Base title={`${p.title} — ${profile.name}`} description={p.description} root="../">
  <article class="pt-16 pb-16 sm:pt-20">
    <a href="../#proyek" class="text-sm text-muted hover:text-cyan">← Semua proyek</a>

    <p class="mt-10 font-mono text-sm text-cyan">{p.context}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{p.title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-muted">{p.description}</p>

    {p.links.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-3 text-sm font-medium">
        {p.links.map((l, i) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            class={i === 0
              ? "rounded bg-pink px-4 py-2 text-night hover:bg-pink/85"
              : "rounded border border-line px-4 py-2 hover:border-cyan hover:text-cyan"}
          >
            {l.label} ↗
          </a>
        ))}
      </div>
    )}

    <div class="horizon mt-12"></div>

    {p.images && p.images.length > 0 && (
      <div class="mt-12 space-y-6">
        {p.images.map((img) => (
          <figure>
            <img src={`${p.slug}/${img.src}`} alt={img.alt} loading="lazy" class="w-full rounded border border-line" />
            <figcaption class="mt-2 text-sm text-muted">{img.alt}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <div class="mt-12 grid gap-12 sm:grid-cols-[1fr_auto]">
      {p.highlights && (
        <section>
          <h2 class="text-sm font-mono uppercase tracking-widest text-pink">Fitur & hasil</h2>
          <ul class="mt-4 space-y-2">
            {p.highlights.map((h) => (
              <li class="relative pl-4 leading-relaxed before:absolute before:left-0 before:text-pink before:content-['›']">{h}</li>
            ))}
          </ul>
        </section>
      )}
      <section>
        <h2 class="text-sm font-mono uppercase tracking-widest text-pink">Teknologi</h2>
        <ul class="mt-4 space-y-1 font-mono text-sm text-cyan/90">
          {p.stack.map((s) => <li>{s}</li>)}
        </ul>
      </section>
    </div>
  </article>

  <nav class="grid grid-cols-2 gap-4 border-t border-line py-8 text-sm">
    <div>
      {prev && (
        <a href={prev.slug} class="group block">
          <span class="text-muted">← Sebelumnya</span>
          <span class="mt-1 block font-medium group-hover:text-cyan">{prev.title}</span>
        </a>
      )}
    </div>
    <div class="text-right">
      {next && (
        <a href={next.slug} class="group block">
          <span class="text-muted">Berikutnya →</span>
          <span class="mt-1 block font-medium group-hover:text-cyan">{next.title}</span>
        </a>
      )}
    </div>
  </nav>
</Base>
