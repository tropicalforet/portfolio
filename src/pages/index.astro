---
import Base from "../layouts/Base.astro";
import { profile, projects, experience, education } from "../data/content";
---

<Base title={`${profile.name} — ${profile.role}`} root="./">
  <section class="pt-24 pb-16 sm:pt-32">
    <p class="font-mono text-sm text-cyan">{profile.role}</p>
    <h1 class="neon mt-3 text-5xl font-bold italic tracking-tight sm:text-7xl">
      {profile.name}<span class="text-cyan">.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{profile.summary}</p>
    <div class="mt-8 flex flex-wrap gap-3 text-sm font-medium">
      <a href="#proyek" class="btn-neon rounded px-4 py-2">Lihat proyek</a>
      <a href={profile.github} target="_blank" rel="noopener" class="rounded border border-line px-4 py-2 hover:border-cyan hover:text-cyan">GitHub</a>
    </div>
  </section>

  <div class="horizon"></div>

  <section id="proyek" class="scroll-mt-20 py-16">
    <h2 class="deco-label">Proyek</h2>
    <ul class="mt-8 divide-y divide-line">
      {projects.map((p) => (
        <li class="group relative py-8 first:pt-0">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-xl font-semibold group-hover:text-cyan">
              <a href={`proyek/${p.slug}`} class="after:absolute after:inset-0">{p.title}</a>
            </h3>
            <span class="text-muted transition-transform group-hover:translate-x-1 group-hover:text-cyan">→</span>
          </div>
          <p class="mt-1 text-sm text-muted">{p.context}</p>
          <p class="mt-3 leading-relaxed">{p.description}</p>
          <p class="mt-4 font-mono text-xs text-cyan/80">{p.stack.join("  ·  ")}</p>
        </li>
      ))}
    </ul>
  </section>

  <div class="horizon opacity-60"></div>

  <section id="pengalaman" class="scroll-mt-20 grid gap-12 py-16 sm:grid-cols-2">
    <div>
      <h2 class="deco-label">Pengalaman</h2>
      <ul class="mt-6 space-y-5">
        {experience.map((e) => (
          <li>
            <p class="font-medium">{e.role}</p>
            <p class="text-sm text-muted">{e.org}</p>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="deco-label">Pendidikan</h2>
      <ul class="mt-6 space-y-5">
        {education.map((e) => (
          <li>
            <p class="font-medium">{e.title}</p>
            <p class="text-sm text-muted">{e.org}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="horizon opacity-60"></div>

  <section id="kontak" class="scroll-mt-20 py-16">
    <h2 class="deco-label">Kontak</h2>
    <p class="mt-6 text-2xl font-semibold sm:text-3xl">Terbuka untuk peluang kerja dan kolaborasi.</p>
    <div class="mt-6 flex flex-col gap-2 text-lg">
      <a href={`mailto:${profile.email}`} class="w-fit text-cyan hover:underline">{profile.email}</a>
      <a href={profile.github} target="_blank" rel="noopener" class="w-fit text-muted hover:text-cyan">github.com/tropicalforet</a>
    </div>
  </section>
</Base>
